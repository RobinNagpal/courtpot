{
  "expo": {
    "name": "CourtPot",
    "slug": "courtpot",
    "version": "1.0.0",
    "scheme": "courtpot",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.robinnagpal.courtpot"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.robinnagpal.courtpot"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"],
    "extra": {
      "eas": {
        "projectId": "2946ef0e-73ec-4310-8007-71faa4867413"
      }
    }
  }
}
