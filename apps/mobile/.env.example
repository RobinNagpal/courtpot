# Where the app finds the CourtPot API (server mode + login).
# In dev this already defaults to http://localhost:7071 — set it only to
# point elsewhere (e.g. your LAN IP for a phone on the same wifi), or to
# the literal value "local" to force offline AsyncStorage mode.
# Production builds/exports use server mode only when this is set.
EXPO_PUBLIC_API_URL=http://localhost:7071
