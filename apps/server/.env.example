# Postgres connection string (Neon/Supabase/Railway/local all work)
DATABASE_URL="postgresql://user:password@localhost:5432/courtpot"
# Port the API listens on. Hosting platforms (Railway/Render/Fly) inject
# their own PORT, which always wins over this default.
PORT=7071
# Separate DB used by the integration tests (wiped between runs)
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/courtpot_test"
