{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint src prisma test",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "pins": "tsx src/cli/pins.ts",
    "user:test": "tsx src/cli/addTestUser.ts"
  },
  "dependencies": {
    "@courtpot/domain": "workspace:*",
    "@courtpot/schemas": "workspace:*",
    "@hono/node-server": "^1.19.1",
    "@hono/zod-validator": "^0.7.2",
    "@prisma/client": "^6.16.1",
    "dotenv": "^17.2.1",
    "hono": "^4.9.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@courtpot/config": "workspace:*",
    "@types/node": "^22.10.0",
    "eslint": "^9.34.0",
    "prisma": "^6.16.1",
    "tsx": "^4.20.4",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
