// Database naming: tables are plural snake_case, columns are snake_case
// (@@map / @map), so no identifier ever needs quoting in raw SQL. Prisma model
// and field names stay PascalCase/camelCase — the mapping is the only place the
// two conventions meet.
generator client {
  provider = "prisma-client-js"
  // "native" for local dev; the second target is the arm64 Lambda runtime
  // (Amazon Linux 2023) — deployment/scripts/build-lambda.sh ships its engine.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id       String        @id
  name     String        @unique
  username String        @unique
  // 4-digit login PIN. Excluded globally via the Prisma client's `omit`
  // config so it can never appear in an API response.
  pin      String
  active   Boolean       @default(true)
  // Platform role, stored as a plain string — the Role enum lives in
  // packages/schemas, so new roles need no migration.
  role     String        @default("TeamMember")
  sessions AuthSession[]
  teams    TeamMember[]
  audited  AuditLog[]

  @@map("members")
}

/**
 * Append-only record of who changed what. actorName is denormalised so an entry
 * still names its author after that member is deleted (actorId goes null).
 */
model AuditLog {
  id        String   @id
  at        DateTime @default(now())
  actorId   String?  @map("actor_id")
  actorName String   @map("actor_name")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  details   Json
  actor     Member?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Team {
  id      String       @id
  name    String       @unique
  // 4-digit PIN that opens the team page. Omitted globally like a member's PIN,
  // so only the unlock check and the admin listing ever see it.
  pin           String
  members       TeamMember[]
  guests        Guest[]
  memberBookings MemberBooking[]
  guestBookings GuestBooking[]
  transfers     Transfer[]

  @@map("teams")
}

/** A member's role in one team. The same member can hold a different role per team. */
model TeamMember {
  teamId   String @map("team_id")
  memberId String @map("member_id")
  role     String @default("TeamMemberViewer")
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([teamId, memberId])
  @@map("team_members")
}

model Guest {
  id     String  @id
  teamId String  @map("team_id")
  name   String  @unique
  note   String?
  team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("guests")
}

model MemberBooking {
  id        String   @id
  teamId    String   @map("team_id")
  date      String
  title     String   @default("")
  memberIds String[] @map("member_ids")
  payers    Json
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("member_bookings")
}

model GuestBooking {
  id     String @id
  teamId String @map("team_id")
  date   String
  title  String @default("")
  // [{ guestId, amount }] — each guest charged their own amount.
  guests Json
  // Either a list of member ids, or the string "ALL" meaning every active member.
  paidBy Json   @map("paid_by")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("guest_bookings")
}

model Transfer {
  id     String  @id
  teamId String  @map("team_id")
  date   String
  fromId String  @map("from_id")
  toId   String  @map("to_id")
  amount Int
  note   String?
  team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("transfers")
}

model AuthSession {
  token     String   @id
  memberId  String   @map("member_id")
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("auth_sessions")
}
