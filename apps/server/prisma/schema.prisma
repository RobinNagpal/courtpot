// Database naming: tables are plural snake_case, columns are snake_case
// (@@map / @map), so no identifier ever needs quoting in raw SQL. Prisma model
// and field names stay PascalCase/camelCase — the mapping is the only place the
// two conventions meet.
generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the second target is the arm64 Lambda runtime
  // (Amazon Linux 2023) — deployment/scripts/build-lambda.sh ships its engine.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id            String        @id
  name          String        @unique
  username      String        @unique
  // 4-digit login PIN. Excluded globally via the Prisma client's `omit`
  // config so it can never appear in an API response.
  pin           String
  active        Boolean       @default(true)
  // Platform role, stored as a plain string — the Role enum lives in
  // packages/schemas, so new roles need no migration.
  role          String        @default("TeamMember")
  // The team this member lands on at login. Null until they pick one.
  defaultTeamId String?       @map("default_team_id")
  defaultTeam   Team?         @relation("MemberDefaultTeam", fields: [defaultTeamId], references: [id], onDelete: SetNull)
  sessions      AuthSession[]
  teams         TeamMember[]
  audited       AuditLog[]

  @@index([defaultTeamId])
  @@map("members")
}

/**
 * Append-only record of who changed what. actorName is denormalised so an entry
 * still names its author after that member is deleted (actorId goes null).
 */
model AuditLog {
  id        String   @id
  at        DateTime @default(now())
  actorId   String?  @map("actor_id")
  actorName String   @map("actor_name")
  action    String
  entity    String
  entityId  String   @map("entity_id")
  details   Json
  actor     Member?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([at])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model Team {
  id             String          @id
  name           String          @unique
  // Optional URL handle for the public team page: /t/<slug>.
  slug           String?         @unique
  // 4-digit PIN that opens the team page. Omitted globally like a member's PIN,
  // so only the unlock check and the admin listing ever see it.
  pin            String
  members        TeamMember[]
  defaultedBy    Member[]        @relation("MemberDefaultTeam")
  guests         Guest[]
  memberBookings MemberBooking[]
  guestBookings  GuestBooking[]
  transfers      Transfer[]
  matches        Match[]

  @@map("teams")
}

/**
 * A member's role in one team. The same member can hold a different role per team.
 */
model TeamMember {
  teamId   String @map("team_id")
  memberId String @map("member_id")
  role     String @default("TeamMemberViewer")
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([teamId, memberId])
  @@map("team_members")
}

model Guest {
  id     String  @id
  teamId String  @map("team_id")
  name   String  @unique
  note   String?
  team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("guests")
}

model MemberBooking {
  id        String   @id
  teamId    String   @map("team_id")
  date      String
  title     String   @default("")
  memberIds String[] @map("member_ids")
  payers    Json
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("member_bookings")
}

model GuestBooking {
  id     String @id
  teamId String @map("team_id")
  date   String
  title  String @default("")
  // [{ guestId, amount }] — each guest charged their own amount.
  guests Json
  // Either a list of member ids, or the string "ALL" meaning every active member.
  paidBy Json   @map("paid_by")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("guest_bookings")
}

model Transfer {
  id     String  @id
  teamId String  @map("team_id")
  date   String
  fromId String  @map("from_id")
  toId   String  @map("to_id")
  amount Int
  note   String?
  team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("transfers")
}

/**
 * One played match. Standalone: it settles no money and references no booking,
 * so nothing in the ledger depends on it.
 *
 * Each side is a first player plus a nullable second, so singles is "both
 * player_2 are null". Columns rather than JSON, so the ids stay queryable and
 * the database can enforce the same rules Zod does — see the migration's CHECK
 * constraints. A player id names a member or a guest, so it carries no foreign
 * key: a Postgres reference points at exactly one table.
 */
model Match {
  id           String  @id
  teamId       String  @map("team_id")
  // ISO-8601 UTC instant, TEXT rather than a timestamp so the row round-trips
  // through JSON unchanged. Ordering by it is chronological only because the Zod
  // schema pins the format to exactly three fractional digits.
  playedAt     String  @map("played_at")
  sideAPlayer1 String  @map("side_a_player_1")
  sideAPlayer2 String? @map("side_a_player_2")
  sideAPoints  Int     @map("side_a_points")
  sideBPlayer1 String  @map("side_b_player_1")
  sideBPlayer2 String? @map("side_b_player_2")
  sideBPoints  Int     @map("side_b_points")
  team         Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  // Every list and the public page order by this.
  @@index([playedAt])
  // One index per slot: "every match this person played" is the query this
  // shape exists to serve — see countMatchesWithPlayer in stores.ts.
  @@index([sideAPlayer1])
  @@index([sideAPlayer2])
  @@index([sideBPlayer1])
  @@index([sideBPlayer2])
  @@map("matches")
}

model AuthSession {
  token     String   @id
  memberId  String   @map("member_id")
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("auth_sessions")
}
